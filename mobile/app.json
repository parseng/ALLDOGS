{
  "expo": {
    "name": "ALLDOGS",
    "slug": "alldogs",
    "scheme": "alldogs",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C3A27"
    },
    "ios": {
      "bundleIdentifier": "it.alldogs.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.alldogs.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C3A27"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AllDogs usa la posizione per registrare il percorso della passeggiata anche a schermo spento.",
          "locationWhenInUsePermission": "AllDogs usa la posizione per mostrarti i sentieri vicini e guidarti durante la passeggiata.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2C3A27"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-asset",
      "expo-sharing"
    ]
  }
}
